---
import Site from '../layouts/Site.astro';
import ported from '../html/home.html?raw';
import { withPictures } from '../pictures/expertise.js';
import { withSectorCards } from '../pictures/sectors.js';
import { withToolCluster } from '../pictures/cluster.js';
import { withBrandColours } from '../pictures/brands.js';
import { withWords } from '../motion/words.js';
import { withIntegrationsLink } from '../integrations/nav.js';
import { withBoot } from '../motion/boot.js';
import { withBrandMark } from '../brand/mark.js';
import { withSystemLinks } from '../systems/links.js';
import { homeScenes } from '../motion/plans.js';
import { withNavName } from '../brand/navname.js';
import { withExpertiseLinks } from '../expertise/links.js';
import { withNumerals } from '../pictures/numerals.js';
import { withTimeline } from '../pictures/timeline.js';
import work from '../html/work.html?raw';
import '../styles/page-home.css';
import '../styles/cards.css';
import '../styles/timeline.css';
import '../styles/mobile.css';
import '../styles/motion.css';
import '../styles/scenes.css';
import '../styles/navbar.css';
import '../styles/boot.css';
import '../styles/brand.css';
import '../styles/theme.css'; // last: the theme overrides the page tokens
import { site } from '../data/site.js';

/* home.html is generated by scripts/port-pages.mjs and stays untouched; the
   expertise pictures, the sector photos, the doubled tool cluster and its
   brand colours, the word-split headings and the opening animation go in
   here, at build time, so a re-port keeps them. Each expertise card opens
   its page (src/expertise/links.js, once the pictures are in, which find
   their cards by the bare titles). The sector cards' links go
   to the systems' pages (src/systems/links.js) — after the photos, which
   find their cards by the old anchors. Then the items are marked to arrive
   as they scroll in, and the first screen is held while the next slides
   over it (src/motion/plans.js); his name gets its place in the nav
   (src/brand/navname.js, after the mark it sits beside); the boot wraps
   the page last. Since 2026-10-04 the hero's three figures are numerals
   (src/pictures/numerals.js) and the experience is a timeline to scale, with
   the covers of the systems each role produced (src/pictures/timeline.js):
   both go in first, on the ported markup they read. */
const visual = withTimeline(withNumerals(ported), { work });
const body = withBoot(withNavName(withBrandMark(withIntegrationsLink(homeScenes(
  withWords(withSystemLinks(withSectorCards(withBrandColours(withToolCluster(withExpertiseLinks(withPictures(visual))))), 'home'), [/<h2 class="say rv">/, /<h2>/]))))));

const title = 'Syed Ali Hamad Gilani — AI Automation Engineer & Web Developer';
/* His full name leads the description: it is the snippet Google shows under
   the title when someone searches for him. */
const description =
  'Syed Ali Hamad Gilani is an AI automation engineer and web developer in Lahore, Pakistan: 62 automations in production and two multi-tenant platforms built end to end.';

/* WebSite on the home page is what Google reads for the "site name" shown
   above the address in results: his name, with the shorter forms as
   alternates. The publisher is the Person the layout marks up. */
const origin = new URL('/', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${origin}#website`,
  name: site.name,
  alternateName: site.alternateNames,
  url: origin,
  description,
  inLanguage: 'en',
  publisher: { '@id': `${origin}#person` },
};
---

<Site title={title} description={description} jsonLd={jsonLd} profile>
  <Fragment set:html={body} />
</Site>
