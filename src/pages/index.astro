---
import Site from '../layouts/Site.astro';
import ported from '../html/home.html?raw';
import { withPictures } from '../pictures/expertise.js';
import '../styles/page-home.css';
import '../styles/cards.css';
import '../styles/mobile.css';
import '../styles/theme.css'; // last: the stucco theme overrides the page tokens
import { site } from '../data/site.js';

/* home.html is generated by scripts/port-pages.mjs and stays untouched; the
   expertise pictures go in here, at build time, so a re-port keeps them. */
const body = withPictures(ported);

const title = 'Syed Ali Hamad Gilani — AI Automation Engineer & Web Developer';
/* His full name leads the description: it is the snippet Google shows under
   the title when someone searches for him. */
const description =
  'Syed Ali Hamad Gilani is an AI automation engineer and web developer in Lahore, Pakistan: 62 automations in production and two multi-tenant platforms built end to end.';

/* WebSite on the home page is what Google reads for the "site name" shown
   above the address in results: his name, with the shorter forms as
   alternates. The publisher is the Person the layout marks up. */
const origin = new URL('/', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${origin}#website`,
  name: site.name,
  alternateName: site.alternateNames,
  url: origin,
  description,
  inLanguage: 'en',
  publisher: { '@id': `${origin}#person` },
};
---

<Site title={title} description={description} jsonLd={jsonLd} profile>
  <Fragment set:html={body} />
</Site>
