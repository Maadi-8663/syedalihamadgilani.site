---
import Site from '../../layouts/Site.astro';
import ported from '../../html/system.html?raw';
import { withSystemArch } from '../../mobile/diagrams.js';
import '../../styles/page-base.css';
import '../../styles/page-system.css';
import '../../styles/mobile.css';
import '../../styles/theme.css'; // last: the stucco theme overrides the page tokens

/* the wide diagram also gets a vertical phone version, built from it (src/mobile/diagrams.js) */
const body = withSystemArch(ported);

const title = 'Lead-to-Cash CRM for Three Contractors — Syed Ali Hamad Gilani';
const description =
  'Delivered. 42 automations live, 73 workflows, 552 nodes — counted directly from the exported workflow JSON.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Lead-to-Cash CRM for Three Contractors',
  description,
  url: new URL('/work/lead-to-cash-crm/', Astro.site).href,
  about: 'Workflow automation for home-services contractors',
  keywords: 'n8n, CRM, lead management, Google Sheets, Twilio, CallRail, offline conversions',
  author: { '@id': new URL('/#person', Astro.site).href },
};
---

<Site title={title} description={description} jsonLd={jsonLd}>
  <Fragment set:html={body} />
</Site>
