---
import Site from '../../layouts/Site.astro';
import ported from '../../html/system.html?raw';
import home from '../../html/home.html?raw';
import { withSystemArch } from '../../mobile/diagrams.js';
import { withSystemCover } from '../../systems/cover.js';
import { withGuardCards } from '../../systems/guards.js';
import { withPortedWorkflow } from '../../systems/page.js';
import { withWords } from '../../motion/words.js';
import { withIntegrationsLink } from '../../integrations/nav.js';
import { withBrandMark } from '../../brand/mark.js';
import { withSystemLinks } from '../../systems/links.js';
import { registerScenes } from '../../motion/plans.js';
import { withBoot } from '../../motion/boot.js';
import '../../styles/page-base.css';
import '../../styles/page-system.css';
import '../../styles/systems.css';
import '../../styles/gallery.css';
import '../../styles/mobile.css';
import '../../styles/motion.css';
import '../../styles/scenes.css';
import '../../styles/navbar.css';
import '../../styles/boot.css';
import '../../styles/brand.css';
import '../../styles/theme.css'; // last: the theme overrides the page tokens

/* the wide diagram also gets a vertical phone version, built from it (src/mobile/diagrams.js) */
/* and the title split into words for motion.css, revealed on load */
/* and its "Next system" link goes to that system's page (src/systems/links.js) */
/* and, since 2026-10-04, it opens on its cover, where the small diagram
   was, and its guards are cards that turn, like every system page
   (src/systems/cover.js, guards.js). */
/* Since 2026-10-08 it opens as the home page does (src/motion/boot.js,
   boot.css), which wraps the page last. */
const body = withBoot(withBrandMark(withIntegrationsLink(registerScenes(withSystemLinks(withWords(withSystemArch(withPortedWorkflow(withGuardCards(withSystemCover(ported)), home)), [/<h1 class="serif"[^>]*>/], 'load'), 'system')))));

const title = 'Lead-to-Cash CRM for Contractors in n8n — Syed Ali Hamad Gilani';
const description =
  'Delivered: an n8n lead-to-cash CRM for three New York contractors. Eight lead sources feed one hub; 42 automations live, 73 workflows, 552 nodes, all counted.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Lead-to-Cash CRM for Three Contractors',
  description,
  url: new URL('/work/lead-to-cash-crm/', Astro.site).href,
  about: 'Workflow automation for home-services contractors',
  keywords: 'n8n, CRM, lead management, Google Sheets, Twilio, CallRail, offline conversions',
  author: { '@id': new URL('/#person', Astro.site).href },
};
---

<Site title={title} description={description} jsonLd={jsonLd}>
  <Fragment set:html={body} />
</Site>
