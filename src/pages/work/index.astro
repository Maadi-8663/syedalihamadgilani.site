---
import Site from '../../layouts/Site.astro';
import ported from '../../html/work.html?raw';
import home from '../../html/home.html?raw';
import system from '../../html/system.html?raw';
import { withWords } from '../../motion/words.js';
import { withIntegrationsLink } from '../../integrations/nav.js';
import { withBrandMark } from '../../brand/mark.js';
import { withGallery } from '../../work/gallery.js';
import { workScenes } from '../../motion/plans.js';
import '../../styles/page-base.css';
import '../../styles/page-work.css';
import '../../styles/gallery.css';
import '../../styles/mobile.css';
import '../../styles/motion.css';
import '../../styles/scenes.css';
import '../../styles/navbar.css';
import '../../styles/brand.css';
import '../../styles/theme.css'; // last: the theme overrides the page tokens

/* work.html is the register as ported: rows under group headers. Since
   2026-10-04 the page shows it as a gallery — a card for every system, its
   cover drawn from its own data — built from those rows at build time
   (src/work/gallery.js), each card opening its system's page. The title is
   split into words for motion.css, and rises on load. */
const body = withBrandMark(withIntegrationsLink(workScenes(withWords(withGallery(ported, { home, system }), [/<h1 class="serif"[^>]*>/], 'load'))));

const title = 'Work — sixteen systems by Syed Ali Hamad Gilani';
const description =
  'Nine delivered for clients, seven built with the workflow JSON in the repo. Every figure is counted or attributed; nothing is estimated.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: new URL('/work/', Astro.site).href,
  author: { '@id': new URL('/#person', Astro.site).href },
};
---

<Site title={title} description={description} jsonLd={jsonLd}>
  <Fragment set:html={body} />
</Site>
