---
import Site from '../layouts/Site.astro';
import work from '../html/work.html?raw';
import home from '../html/home.html?raw';
import { integrationsPage, TOOL_COUNT, spell } from '../integrations/page.js';
import { withWords } from '../motion/words.js';
import '../styles/page-base.css';
import '../styles/page-work.css';
import '../styles/integrations.css';
import '../styles/mobile.css';
import '../styles/motion.css';
import '../styles/theme.css'; // last: the stucco theme overrides the page tokens

/* Not a ported page: it is built from src/integrations/ at build time, in
   the register's clothes (see page.js). Its title rises word by word on
   load and its group names as they scroll in, as on /work/. */
const body = withWords(withWords(integrationsPage({ work, home }), [/<h1 class="serif"[^>]*>/], 'load'), [/<h2>/]);

const title = `Integrations — ${spell(TOOL_COUNT)} tools, connected by Syed Ali Hamad Gilani`;
const description =
  'What each integration does: n8n, WhatsApp, OpenAI, HubSpot, GoHighLevel, Google Workspace, Shopify, Stripe and the rest of the tools Syed Ali Hamad Gilani connects and builds with.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: new URL('/integrations/', Astro.site).href,
  author: { '@id': new URL('/#person', Astro.site).href },
};
---

<Site title={title} description={description} jsonLd={jsonLd}>
  <Fragment set:html={body} />
</Site>
