---
import Site from '../../layouts/Site.astro';
import ported from '../../html/sector.html?raw';
import home from '../../html/home.html?raw';
import work from '../../html/work.html?raw';
import { withSectorGallery } from '../../work/gallery.js';
import { withSectorFlow, withTouchCopy } from '../../mobile/diagrams.js';
import { withWords } from '../../motion/words.js';
import { withTnodeColours } from '../../pictures/brands.js';
import { withIntegrationsLink } from '../../integrations/nav.js';
import { withBrandMark } from '../../brand/mark.js';
import { withSystemLinks } from '../../systems/links.js';
import { registerScenes } from '../../motion/plans.js';
import { withBoot } from '../../motion/boot.js';
import '../../styles/page-base.css';
import '../../styles/page-sector.css';
import '../../styles/gallery.css';
import '../../styles/mobile.css';
import '../../styles/motion.css';
import '../../styles/scenes.css';
import '../../styles/navbar.css';
import '../../styles/boot.css';
import '../../styles/brand.css';
import '../../styles/theme.css'; // last: the theme overrides the page tokens

/* the wide diagram also gets a vertical phone version, built from it (src/mobile/diagrams.js) */
/* and the headings split into words for motion.css: the title on load, the
   rest as they scroll in */
/* and the tool marks in their brands' colours, and the nav's Integrations link */
/* and its links to the systems pointed at their pages (src/systems/links.js) */
/* and, since 2026-10-06, its lists of systems shown as the gallery's cards
   (src/work/gallery.js), after the links are counted */
/* Since 2026-10-08 it opens as the home page does (src/motion/boot.js,
   boot.css), which wraps the page last. */
const body = withBoot(withBrandMark(withIntegrationsLink(registerScenes(withSectorGallery(withSystemLinks(withWords(withWords(withTouchCopy(withTnodeColours(withSectorFlow(ported))), [/<h1>/], 'load'),
  [/<h2 class="serif"[^>]*>/, /<h2 class="serif-i"[^>]*>/]), 'sector'), { home, work })))));

const title = 'Home Services & Construction Automation — Syed Ali Hamad Gilani';
const description =
  'Automation for contractors and field-service firms: a lead-to-cash CRM, a Google Local Services Ads responder and construction outreach. 44 automations counted.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Home services & construction',
  description,
  url: new URL('/sectors/home-services/', Astro.site).href,
  author: { '@id': new URL('/#person', Astro.site).href },
};
---

<Site title={title} description={description} jsonLd={jsonLd}>
  <Fragment set:html={body} />
</Site>
